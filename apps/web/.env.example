# ==========================================================================
# PLANTILLA DE VARIABLES DE ENTORNO — Plurall Web
# Copia este archivo como `.env.local` y reemplaza los valores.
#   cp .env.example .env.local   (Linux/Mac)   |   copy .env.example .env.local  (Windows)
# NUNCA subas tu .env.local (contiene secretos). Este archivo solo lleva placeholders.
# Tras editar .env.local, reinicia el servidor (npm run dev) para que tome los cambios.
# ==========================================================================

# ── Supabase ──────────────────────────────────────────────────────────────
# URL y anon key son PÚBLICAS (van al navegador). Pídelas al líder del proyecto
# o cópialas desde Supabase → Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_anon_key
# SECRETO — acceso total a la BD (ignora RLS). Solo servidor, nunca lo expongas.
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key

# ── Wompi (pasarela de pagos) ─────────────────────────────────────────────
# Para desarrollo usa llaves de PRUEBA (pub_test_ / prv_test_), no las de producción.
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=pub_test_xxxxxxxxxxxxxxxx
WOMPI_PRIVATE_KEY=prv_test_xxxxxxxxxxxxxxxx
WOMPI_EVENTS_SECRET=test_events_xxxxxxxxxxxxxxxx
# Llave de integridad del widget de checkout (dashboard.wompi.co → Desarrolladores → Llaves)
WOMPI_INTEGRITY_SECRET=

# ── Resend (emails) ───────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=onboarding@resend.dev

# ── Upstash (rate limiting) ───────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=https://tu-instancia.upstash.io
UPSTASH_REDIS_REST_TOKEN=tu_token_upstash

# ── Gmail SMTP (OTP recuperación de contraseña) ───────────────────────────
GMAIL_FROM_EMAIL=tucorreo@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ── Sentry (monitoreo de errores) ─────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=tu-organizacion-sentry
SENTRY_PROJECT=plurall
# Suprime el warning de Sentry en desarrollo local con Turbopack
SENTRY_SUPPRESS_TURBOPACK_WARNING=1

# ── App ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=PLURALL

# ── Cron Jobs (protege /api/cron/mora) ────────────────────────────────────
# Genera un secreto: openssl rand -hex 32
CRON_SECRET=cambia_esto_por_un_secreto_seguro
