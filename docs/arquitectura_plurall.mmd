flowchart TD
    %% ============================================================
    %% PLURALL — Diagrama de Arquitectura v2.0
    %% Actualizado: Sprint 3
    %% ============================================================

    subgraph PUBLICO["🌐 Zona Pública (sin auth)"]
        LP["/ — Landing Page"]
        LG["/login — Login"]
        RG["/registro — Registro"]
        RC["/recuperar — Reset Password"]
        CB["/auth/callback — Supabase Callback"]
    end

    subgraph PRIVADO["🔒 Zona Privada (requiere sesión)"]
        DI["/dashboard/inicio"]
        DP["/dashboard/perfil"]
        DC["/dashboard/creditos — Mis Créditos"]
        DS["/dashboard/creditos/solicitar — Solicitar Crédito"]
        DD["/dashboard/documentos — Documentos KYC"]
    end

    subgraph API["⚙️ API Routes (Servidor)"]
        AS["/api/solicitud — POST crear solicitud"]
        AU["/api/documentos/upload — POST subir doc"]
    end

    subgraph MIDDLEWARE["🛡️ Middleware Next.js"]
        MW["middleware.js → updateSession()"]
        MW_PUBLIC["Rutas públicas: /, /login, /registro, /recuperar"]
        MW_PRIVATE["Rutas privadas: /dashboard/* → redirect /login si no hay sesión"]
    end

    subgraph FRONTEND_LIBS["📦 Librerías Frontend"]
        CALC["lib/calculadora.js\ncalcularAmortizacion()\nformatCOP()"]
        SUP_CLI["lib/supabase/client.js\ncreateBrowserClient()"]
        SUP_SRV["lib/supabase/server.js\ncreateServerClient()"]
        SUP_MID["lib/supabase/middleware.js\nupdateSession()"]
    end

    subgraph SUPABASE["☁️ Supabase (BaaS — $0/mes)"]
        direction TB
        AUTH["Auth\n• signInWithPassword()\n• signUp()\n• resetPasswordForEmail()\n• signOut()"]

        subgraph DB["PostgreSQL"]
            T1["perfil_usuario"]
            T2["cliente"]
            T3["solicitud_credito"]
            T4["credito"]
            T5["cuota_pago"]
            T6["documento_cliente"]
            T7["detalle_cliente"]
        end

        subgraph TRIGGERS["Triggers SQL"]
            TRG1["trg_auto_confirm_user\n→ marca email confirmado al instante"]
            TRG2["trg_handle_new_user_registration\n→ crea perfil_usuario + cliente"]
        end

        STORAGE["Storage (Bucket Privado)\ndocumentos-kyc/"]
        RLS["RLS Policies\n• cliente solo ve sus datos\n• admin ve todo"]
    end

    subgraph EXTERNOS["🔌 Servicios Externos (futuros sprints)"]
        WOMPI["Wompi\nPasarela de Pagos\n(Sprint 4)"]
        RESEND["Resend\nEmails Transaccionales\n(Sprint 2-4)"]
        UPSTASH["Upstash Redis\nRate Limiting\n(Sprint 1-2)"]
        SENTRY["Sentry\nMonitoreo Errores\n(Sprint 5)"]
    end

    %% ── Flujo de Autenticación ──
    LG -->|"signInWithPassword()"| AUTH
    RG -->|"signUp() + metadata"| AUTH
    RC -->|"resetPasswordForEmail()"| AUTH
    AUTH -->|"AFTER INSERT trigger"| TRG1
    TRG1 --> TRG2
    TRG2 -->|"INSERT"| T1
    TRG2 -->|"INSERT"| T2
    CB -->|"exchangeCodeForSession()"| AUTH
    AUTH -->|"redirect"| DI

    %% ── Middleware ──
    MW --> MW_PUBLIC
    MW --> MW_PRIVATE
    MW_PRIVATE -->|"sin sesión → redirect"| LG
    SUP_MID --> MW

    %% ── Dashboard (SSR) ──
    DI -->|"getUser() SSR"| SUP_SRV
    DP -->|"getUser() SSR"| SUP_SRV
    DC -->|"solicitud_credito del cliente"| T3
    DS -->|"calcularAmortizacion()"| CALC
    DS -->|"POST /api/solicitud"| AS
    AS -->|"INSERT solicitud_credito"| T3
    DD -->|"upload → Supabase Storage"| STORAGE
    DD -->|"INSERT documento_cliente"| T6
    AU --> STORAGE
    AU --> T6

    %% ── Librerías ──
    SUP_SRV --> AUTH
    SUP_CLI --> AUTH

    %% ── Externos ──
    AS -.->|"Sprint 4"| WOMPI
    TRG2 -.->|"Sprint 2"| RESEND
    MW -.->|"Sprint 2"| UPSTASH

    %% ── Estilos ──
    classDef public fill:#e0f2fe,stroke:#0284c7,color:#0c4a6e
    classDef private fill:#fef9c3,stroke:#ca8a04,color:#713f12
    classDef api fill:#f0fdf4,stroke:#16a34a,color:#14532d
    classDef supabase fill:#ecfdf5,stroke:#059669,color:#064e3b
    classDef external fill:#fdf4ff,stroke:#9333ea,color:#4a044e

    class LP,LG,RG,RC,CB public
    class DI,DP,DC,DS,DD private
    class AS,AU api
    class AUTH,T1,T2,T3,T4,T5,T6,T7,TRG1,TRG2,STORAGE,RLS supabase
    class WOMPI,RESEND,UPSTASH,SENTRY external
